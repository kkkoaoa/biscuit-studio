    "autoprefixer": "^10.4.20",
    "lint-staged": "~13.1.0",
    "@biomejs/biome": "1.9.4",
    "postcss": "^8.4.49",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.7.3",
    "@types/node": "^20",
    "@types/react": "~19.2.7",
    "@types/react-dom": "~19.2.3",
    "rimraf": "~3.0.2"
  }
}
