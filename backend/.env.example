# Biscuit Studio backend environment

# Comma-separated browser origins allowed by CORS.
# Keep this list explicit in production; do not include paths or a trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Subtitle service credentials. Keep real values on the server only.
SUBTITLE_APP_ID=
SUBTITLE_ACCESS_TOKEN=
